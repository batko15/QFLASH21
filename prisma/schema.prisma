generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Runtime: Supabase PgBouncer-Pooler (Port 6543, transaction mode)
  directUrl = env("DIRECT_URL") // Migrationen/db push: direkte Verbindung (Port 5432)
}

model OperationLog {
  id         String   @id @default(cuid())
  operation  String
  status     String   @default("OK")
  vehicle    String?
  ecuType    String?
  details    String?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
