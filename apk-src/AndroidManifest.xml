<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="de.qflash21.app"
    android:versionCode="53"
    android:versionName="2.3.0">

  <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34"/>

  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

  <!-- USB-Host: K+DCAN-Kabel (FTDI/CH340/CP2102) direkt per Android USB-Host-API.
       required=false: App bleibt auf Geräten ohne USB-Host installierbar. -->
  <uses-feature android:name="android.hardware.usb.host" android:required="false"/>

  <application
      android:name=".QfApp"
      android:label="QFLASH21"
      android:icon="@mipmap/ic_launcher"
      android:allowBackup="false"
      android:supportsRtl="true"
      android:theme="@android:style/Theme.Material.NoActionBar">

    <!--
      v2.2.0 – STANDALONE mit Interceptor-Architektur (ersetzt v2.1.0):
      - FIX für „App bleibt weiß": v2.1.0 servierte die Oberfläche über einen
        Loopback-HTTP-Server (127.0.0.1:21921) – auf dem Gerät des Nutzers
        erreichte die WebView-Netzwerkschicht diesen nie (Cleartext/localhost-
        Restriktionen, VPN-/ROM-Interferenz) → weiße Fläche.
      - NUN: WebViewClient.shouldInterceptRequest bedient die virtuelle Domain
        https://appassets.androidplatform.net/ direkt aus der APK (offizielles
        WebViewAssetLoader-Muster, ohne AndroidX). Kein Socket, kein Port,
        kein Cleartext, kein DNS → keine Netzwerkschicht mehr im Spiel.
      - QfNativeApi (window.QfNativeApi): lokale APIs (Operationshistorie,
        DTC-Analyse), Downloads, Diagnostik, Clipboard.
      - NIE WIEDER WEIẞ: onReceivedError/onReceivedHttpError → deutsche
        Fehlerseite mit Diagnose + „Erneut versuchen"; Render-Watchdog;
        onRenderProcessGone baut die WebView neu auf.
      - SerialBridge (window.QfSerialBridge): Android USB-Host-API für das
        K+DCAN-Kabel (FTDI/CH340/CP2102) per USB-OTG – unverändert.
      - Gleiche Paket-ID + Signatur wie v1.3.x/v2.0.0/v2.1.0 → sauberes Upgrade
      - QfApp: globaler Crash-Handler → nativer deutscher Fehlerbericht
    -->
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|density">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>

    <!-- Nativer deutscher Fehlerbericht (auch ohne WebView lauffähig) -->
    <activity
        android:name=".CrashActivity"
        android:exported="false"
        android:excludeFromRecents="true"/>
  </application>
</manifest>
